layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                // Thêm nền màu #181825 (Mantle của Catppuccin) cho toàn bộ thanh Bar
                format_left   "#[bg=#181825,fg=#89b4fa,bold] {session} #[bg=#181825,fg=#45475a]│{tabs}"
                format_right  "#[bg=#181825]"
                format_space  "#[bg=#181825]"

                border_enabled  "false"

                tab_normal   "#[bg=#181825,fg=#6c7086] {index} {name} "
                tab_active   "#[bg=#181825,fg=#a6e3a1,bold] {index} [{name}] "
            }
        }
        children
        floating_panes {
            pane {
                x "10%"
                y "10%"
                width "80%"
                height "80%"
            }
        }
    }
}
