keybinds clear-defaults=true {
    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
    }
    renametab {
        bind "enter" { SwitchToMode "normal"; }
        bind "esc" { UndoRenameTab; SwitchToMode "normal"; }
    }
    shared_except "locked" {
        // Điều hướng Focus (Vim-style)
        bind "Alt h" { MoveFocusOrTab "left"; }
        bind "Alt j" { MoveFocus "down"; }
        bind "Alt k" { MoveFocus "up"; }
        bind "Alt l" { MoveFocusOrTab "right"; }

        // Quản lý Pane
        bind "Alt n" { NewPane; }
        bind "Alt w" { CloseFocus; }
        bind "Alt z" { ToggleFocusFullscreen; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt p" { TogglePaneEmbedOrFloating; }
        bind "Alt \\" { NewPane "Right"; }
        bind "Alt -" { NewPane "Down"; }

        // Quản lý Tab
        bind "Alt t" { NewTab; }
        bind "Alt i" { MoveTab "left"; }
        bind "Alt o" { MoveTab "right"; }
        bind "Alt r" { SwitchToMode "renametab"; TabNameInput 0; }

        // Chuyển Tab (1-9)
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        
        // Điều chỉnh kích thước (Resize)
        bind "Alt Shift h" { Resize "Increase left"; }
        bind "Alt Shift j" { Resize "Increase down"; }
        bind "Alt Shift k" { Resize "Increase up"; }
        bind "Alt Shift l" { Resize "Increase right"; }

        // Điều hướng Pane nhanh
        bind "Alt [" { FocusPreviousPane; }
        bind "Alt ]" { FocusNextPane; }

        // Tính năng mở rộng & Hành động
        bind "Alt s" { ToggleActiveSyncTab; }
        bind "Alt q" { Detach; }
        bind "Alt /" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "Alt e" { EditScrollback; SwitchToMode "normal"; }
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Alt c" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        } 
    }
}

plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

load_plugins {
    zellij:link
}

web_client {
    font "monospace"
}

// Cấu hình môi trường và giao diện
theme "default"
default_layout "default"
pane_frames false
copy_command "wl-copy"
session_serialization true
show_startup_tips false

themes {
    default {
        bg "#181825" // Mantle (Tạo độ chìm tinh tế so với Base của Terminal)
        fg "#cdd6f4" // Text tiêu chuẩn
        red "#f38ba8"
        green "#a6e3a1"
        yellow "#f9e2af"
        blue "#89b4fa" // Màu nhấn chính (Blue)
        magenta "#cba6f7"
        cyan "#89dceb"
        orange "#fab387"
        black "#11111b" // Crust (Nền tab không hoạt động tối nhất)
        white "#cdd6f4"
    }
}
