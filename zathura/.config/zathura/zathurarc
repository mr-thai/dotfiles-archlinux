# ==============================================================================
# PREMIUM ZATHURA CONFIGURATION - CATPPUCCIN MOCHA THEME (DARK MODE)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GENERAL SETTINGS & WAYLAND CLIPBOARD
# ------------------------------------------------------------------------------
# Sử dụng clipboard hệ thống để tương thích hoàn toàn với wl-copy và các ứng dụng khác
set selection-clipboard clipboard

# Cuộn mượt từng bước (Smooth scrolling step)
set scroll-step 60
set page-padding 12
set statusbar-home-tilde true
set adjust-open "width"

# ------------------------------------------------------------------------------
# 2. DARK MODE & RECOLOR
# ------------------------------------------------------------------------------
set recolor                   "true"
set recolor-keephue           "true"

# ------------------------------------------------------------------------------
# 3. COLOR PALETTE - AUTHENTIC CATPPUCCIN MOCHA
# ------------------------------------------------------------------------------
# Base & Text (Mocha Base #1e1e2e, Text #cdd6f4)
set default-fg                rgba(205,214,244,1)
set default-bg                rgba(30,30,46,1)

# Completion Menu (Surface0 #313244, Mauve #cba6f7)
set completion-bg             rgba(49,50,68,1)
set completion-fg             rgba(205,214,244,1)
set completion-highlight-bg   rgba(203,166,247,1)
set completion-highlight-fg   rgba(17,17,27,1)
set completion-group-bg       rgba(69,71,90,1)
set completion-group-fg       rgba(203,166,247,1)

# Status bar & Input bar (Crust #11111b, Surface0 #313244)
set statusbar-fg              rgba(205,214,244,1)
set statusbar-bg              rgba(24,24,37,1)
set inputbar-fg               rgba(205,214,244,1)
set inputbar-bg               rgba(24,24,37,1)

# Notifications (Red #f38ba8, Yellow #f9e2af)
set notification-bg           rgba(49,50,68,1)
set notification-fg           rgba(205,214,244,1)
set notification-error-bg     rgba(49,50,68,1)
set notification-error-fg     rgba(243,139,168,1)
set notification-warning-bg   rgba(49,50,68,1)
set notification-warning-fg   rgba(249,226,175,1)

# Recolor Dark Mode (Base #1e1e2e, Text #cdd6f4)
set recolor-lightcolor        rgba(30,30,46,1)
set recolor-darkcolor         rgba(205,214,244,1)

# Highlights & Index
set highlight-color           rgba(137,180,250,0.4)
set highlight-active-color    rgba(203,166,247,0.5)
set index-fg                  rgba(205,214,244,1)
set index-bg                  rgba(30,30,46,1)
set index-active-fg           rgba(17,17,27,1)
set index-active-bg           rgba(203,166,247,1)

# ------------------------------------------------------------------------------
# 4. KEYBINDINGS (ERGONOMIC VIM SCROLLING)
# ------------------------------------------------------------------------------
map r recolor
map d toggle_page_mode
map + zoom in
map - zoom out

# Khôi phục cuộn mượt cho con lăn chuột và phím điều hướng
map <ScrollUp>   scroll up
map <ScrollDown> scroll down
map <Up>         scroll up
map <Down>       scroll down

# Gán phím nhảy trang riêng biệt
map J navigate next
map K navigate previous
map <Space> navigate next
map <BackSpace> navigate previous
