# ==========================================
# AUTOSTART — Daemons & startup applications
# ==========================================

# --- CORE SYSTEM (Wayland & Polkit) ---
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway XDG_SESSION_TYPE=wayland XDG_SESSION_ID XDG_VTNR
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XDG_SESSION_ID XDG_VTNR
exec bash -c 'sleep 1 && systemctl --user restart xdg-desktop-portal-wlr.service xdg-desktop-portal.service'
exec gnome-keyring-daemon --start --components=secrets


# --- BACKGROUND DAEMONS ---
exec udiskie

    
# exec bash -c "bash ~/.config/sway/scripts/workspace_osd.sh &"
# exec bash -c "bash ~/.config/sway/scripts/app_osd.sh &"
exec autotiling
exec fcitx5 -d


# --- DankMaterialShell ---
exec_always sh -c 'dms kill; sleep 0.5; dms run'
exec valent --gapplication-service


# --- AUTOSTART APPS ---
exec bash -c 'sleep 1.5 && swaymsg "workspace 1" && (footclient || foot)'
exec Zalo.AppImage
exec obsidian
exec zen "zen-browser"

