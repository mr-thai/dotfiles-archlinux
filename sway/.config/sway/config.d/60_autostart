# ==========================================
# AUTOSTART — Daemons & startup applications
# ==========================================

# --- CORE SYSTEM (Wayland & Polkit) ---
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway XDG_SESSION_TYPE=wayland XDG_SESSION_ID XDG_VTNR
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XDG_SESSION_ID XDG_VTNR
exec bash -c 'sleep 1 && systemctl --user restart xdg-desktop-portal-wlr.service xdg-desktop-portal.service'
exec gnome-keyring-daemon --start --components=secrets
exec warpd
exec easyeffects --gapplication-service

# --- POWER MANAGEMENT & LOCK SCREEN ---
# exec_always ~/.config/sway/scripts/start_swayidle.sh

# --- BACKGROUND DAEMONS ---
exec udiskie
exec kanshi

exec ~/.config/sway/scripts/actions/sway_swallow.py &
# exec_always "pkill swaync; sleep 1 && swaync"
exec_always bash -c "bash ~/.config/sway/scripts/workspace_osd.sh &"
exec foot --server
exec autotiling
exec fcitx5 -d
exec wl-paste --type text  --watch bash -c 'wl-paste -l | grep -q "x-kde-passwordManagerHint" || cliphist store'
exec wl-paste --type image --watch bash -c 'wl-paste -l | grep -q "x-kde-passwordManagerHint" || cliphist store'
exec xwaylandvideobridge

exec bash -c "sleep 2 && eww open fcitx_hud"
# --- DankMaterialShell ---
exec_always dms kill; exec dms run
exec valent --gapplication-service
# exec_always "pkill swayosd-server; swayosd-server"

# --- AUTOSTART APPS ---
exec bash -c 'sleep 1.5 && swaymsg "workspace 1" && (footclient || foot)'
exec Zalo.AppImage
exec obsidian
exec zen "zen-browser"

