# ==========================================
# VARIABLES — Single source of truth
# ==========================================

# --- MODIFIER KEY ---
set $mod Mod4

# --- NAVIGATION KEYS (vim-style) ---
set $left  h
set $down  j
set $up    k
set $right l

# --- SCRIPT PATHS ---
set $scripts           ~/.config/sway/scripts
set $powermenu         $scripts/power_menu.sh
set $window_switcher   $scripts/window_switcher.sh
set $toggle_scratchpad $scripts/actions/toggle_scratchpad.sh

# --- CURSOR THEME ---
set $cursor_theme catppuccin-mocha-dark-cursors
set $cursor_size  24

# --- COLOR PALETTE (Catppuccin Mocha) ---
