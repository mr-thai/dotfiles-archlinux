# ==========================================
# OUTPUT — Monitor layout & workspace routing
# ==========================================

# --- EXTERNAL MONITOR (DP-1) ---
output "DP-1" {
    mode 1920x1080@60.0Hz
    pos 0 1080
    transform 180
    scale 1.0
    scale_filter smart
    adaptive_sync on
    dpms on
}

# --- LAPTOP MONITOR (eDP-1) ---
output "eDP-1" {
    # Refresh rate (59.977Hz) optimized for smoothness
    mode 1920x1080@59.977Hz
    pos 0 0
    transform normal
    scale 1.0
    scale_filter smart
    adaptive_sync on
    dpms on
}

# --- DEFAULT / UNKNOWN MONITORS ---
output * {
    resolution 1920x1080
    scale 1.0
    adaptive_sync on
    max_render_time 2
    subpixel rgb
    render_bit_depth 10
}

# --- WORKSPACE ROUTING (PURE SYNTAX) ---
# Sway tự động fallback nếu màn hình ưu tiên bị rút ra
workspace 1 output eDP-1 DP-1
workspace 2 output DP-1 eDP-1
workspace 3 output DP-1 eDP-1
workspace 4 output DP-1 eDP-1
workspace 5 output DP-1 eDP-1
workspace 6 output DP-1 eDP-1
workspace 7 output DP-1 eDP-1
workspace 8 output DP-1 eDP-1
workspace 9 output DP-1 eDP-1
workspace 10 output DP-1 eDP-1
