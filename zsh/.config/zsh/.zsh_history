: 1781772696:0;sudo bash -c '\
# 1. Tr√≠ch xu·∫•t danh s√ÉÅch ch·∫∑n c≈© ra file l∆∞u tr·ªØ\
sed -n "/# --- BLOCK WEB ---/,/# --- END BLOCK WEB ---/p" /etc/hosts > /etc/hosts.block\
\
# 2. X√≥a danh s√ÉÅch ch·∫∑n c≈© kh·ªÉØi file h·ªÉß th·ªÉ±ng (gi·∫£i ph√≥ng m·∫ÉÅng)\
sed -i "/# --- BLOCK WEB ---/,/# --- END BLOCK WEB ---/d" /etc/hosts\
\
# 3. C·∫≠p nh·∫≠t l·∫ÉÅi code c·ªßa n√∫t b·∫•m ƒÉ±·ªÉ£ n√≥ d√πng chung danh s√ÉÅch c·ªßa b·∫ÉÅn\
cat << "EOF" > /usr/local/bin/web_blocker\
#!/bin/bash\
HOSTS_FILE="/etc/hosts"\
BLOCK_FILE="/etc/hosts.block"\
\
case "$1" in\
    toggle)\
        if grep -q "# --- BLOCK WEB ---" "$HOSTS_FILE"; then\
            sed -i "/# --- BLOCK WEB ---/,/# --- END BLOCK WEB ---/d" "$HOSTS_FILE"\
        else\
            cat "$BLOCK_FILE" >> "$HOSTS_FILE"\
        fi\
        resolvectl flush-caches 2>/dev/null || true\
        ;;\
    status)\
        if grep -q "# --- BLOCK WEB ---" "$HOSTS_FILE"; then\
            echo "true"\
        else\
            echo "false"\
        fi\
        ;;\
esac\
EOF\
resolvectl flush-caches 2>/dev/null || true\
'
