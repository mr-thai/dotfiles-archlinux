: 1784282223:0;sudo bash -c '\
cat << "EOF" > /usr/local/bin/web_blocker\
#!/bin/bash\
BLOCK_FILE="/etc/hosts.block"\
HOSTS_FILE="/etc/hosts"\
\
if [ ! -f "$BLOCK_FILE" ]; then\
    cat << "INNER_EOF" > "$BLOCK_FILE"\
# --- WEB BLOCKER ---\
127.0.0.1 facebook.com www.facebook.com\
127.0.0.1 youtube.com www.youtube.com\
127.0.0.1 tiktok.com www.tiktok.com\
127.0.0.1 instagram.com www.instagram.com\
127.0.0.1 reddit.com www.reddit.com\
127.0.0.1 twitter.com www.twitter.com\
127.0.0.1 x.com www.x.com\
# -------------------\
INNER_EOF\
fi\
\
case "$1" in\
    toggle)\
        if grep -q "# --- WEB BLOCKER ---" "$HOSTS_FILE"; then\
            sed -i "/# --- WEB BLOCKER ---/,/# -------------------/d" "$HOSTS_FILE"\
        else\
            cat "$BLOCK_FILE" >> "$HOSTS_FILE"\
        fi\
        resolvectl flush-caches 2>/dev/null || true\
        ;;\
    status)\
        if grep -q "# --- WEB BLOCKER ---" "$HOSTS_FILE"; then\
            echo "true"\
        else\
            echo "false"\
        fi\
        ;;\
esac\
EOF\
chmod +x /usr/local/bin/web_blocker\
echo "mr-thai ALL=(ALL) NOPASSWD: /usr/local/bin/web_blocker" > /etc/sudoers.d/web_blocker\
chmod 440 /etc/sudoers.d/web_blocker\
'
