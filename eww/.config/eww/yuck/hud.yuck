

;; ==============================================================================
;; Screen Recorder HUD Window
;; ==============================================================================
(defwindow record_hud
  :monitor 0
  :geometry (geometry :x "20px" :y "20px" :anchor "top left" :width "120px" :height "46px")
  :stacking "fg"
  :exclusive false
  (record_layout))

(defwidget record_layout []
  (eventbox :cursor "pointer"
            :onclick "~/.config/sway/scripts/actions/record_screen.sh stop"
            :tooltip "Recording screen. Click to Stop."
    (box :class "record-container"
         :orientation "h" :space-evenly false :halign "center" :valign "center"
         (label :class "record-icon" :text "󰑋")
         (label :class "record-text" :text " REC"))))



;; ==============================================================================
;; Workspace OSD HUD Window
;; ==============================================================================
(defwindow workspace_osd
  :monitor 0
  :geometry (geometry :x "20px" :y "20px" :anchor "bottom left" :width "60px" :height "60px")
  :stacking "overlay"
  :exclusive false
  (workspace_osd_layout))

(defwidget workspace_osd_layout []
  (box :class "ws-osd-container"
       :orientation "v" :space-evenly false :halign "center" :valign "center"
       (label :class "ws-osd-text" :text "${current_workspace}")))

;; ==============================================================================
;; App Icon OSD HUD Window
;; ==============================================================================
(defwindow app_osd
  :monitor 0
  :geometry (geometry :x "20px" :y "80px" :anchor "top left" :width "48px" :height "48px")
  :stacking "overlay"
  :exclusive false
  (app_osd_layout))

(defwidget app_osd_layout []
  (box :class "app-osd-container"
       :orientation "v" :space-evenly false :halign "center" :valign "center"
       (image :path current_app_icon :image-width 32 :image-height 32)))
