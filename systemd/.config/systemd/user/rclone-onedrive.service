[Unit]
Description=Rclone Mount OneDrive
AssertPathIsDirectory=%h/Cloud/OneDrive
After=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/rclone mount onedrive: %h/Cloud/OneDrive \
    --vfs-cache-mode full \
    --vfs-cache-max-size 5G \
    --vfs-cache-max-age 24h \
    --dir-cache-time 48h
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
