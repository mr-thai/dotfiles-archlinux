[Unit]
Description=Auto commit and push dotfiles to GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/dotfiles
ExecStart=/usr/bin/bash -c 'git add -A && git diff-index --quiet HEAD || (git commit -m "Auto-backup: $(date \"+%%Y-%%m-%%d %%H:%%M:%%S\")" && git push origin main)'
SuccessExitStatus=0 1
